---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found. Explore Innamora attars, essential oils and rose water, or contact our team." noindex>
  <section class="section" style="text-align:center">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This page has <em>evaporated.</em></h1>
      <p class="lead" style="margin:20px auto 0">The link may be old or mistyped. Explore our products or get in touch.</p>
      <div class="actions" style="justify-content:center"><a class="btn" href="/products">View Products</a><a class="btn btn--ghost" href="/contact">Contact Us</a></div>
    </div>
  </section>
</BaseLayout>
