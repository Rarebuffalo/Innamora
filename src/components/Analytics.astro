---
/* Loads only the tags whose IDs are set in src/data/site.js → ANALYTICS. */
import { ANALYTICS as A } from "../data/site.js";
const gtag = !A.gtmId && (A.ga4Id || A.googleAdsId);
const cfg = JSON.stringify({ ga4: A.ga4Id, ads: A.googleAdsId, adsLead: A.googleAdsLeadLabel, gtm: !!A.gtmId, pixel: !!A.metaPixelId });
---
{A.googleSiteVerification && <meta name="google-site-verification" content={A.googleSiteVerification} />}
{A.bingSiteVerification && <meta name="msvalidate.01" content={A.bingSiteVerification} />}
<script is:inline define:vars={{ cfg }}>window.INNAMORA_ANALYTICS = JSON.parse(cfg); window.dataLayer = window.dataLayer || [];</script>
{A.gtmId && (
  <script is:inline define:vars={{ id: A.gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
  </script>
)}
{gtag && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${A.ga4Id || A.googleAdsId}`}></script>
    <script is:inline define:vars={{ ga4: A.ga4Id, ads: A.googleAdsId }}>
      function gtag(){dataLayer.push(arguments);} window.gtag = gtag;
      gtag('js', new Date()); if (ga4) gtag('config', ga4); if (ads) gtag('config', ads);
    </script>
  </>
)}
{!A.gtmId && A.metaPixelId && (
  <script is:inline define:vars={{ id: A.metaPixelId }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', id); fbq('track', 'PageView');
  </script>
)}
